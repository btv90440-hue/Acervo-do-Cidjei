{
  "id": "/",
  "name": "Acervo do Cidjei",
  "short_name": "Acervo",
  "description": "Biblioteca e player de filmes armazenados localmente ou no Google Drive.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#eef1f2",
  "theme_color": "#eef1f2",
  "categories": ["entertainment", "video"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Atualizar filmes do Drive", "short_name": "Atualizar", "url": "/?acao=sync", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Buscar um filme", "short_name": "Buscar", "url": "/?acao=buscar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
